# Copy to .env and fill in. Every script does `import _trace`, which loads this
# file. With nothing set, the scripts still run — they just don't trace.

# LangSmith tracing (optional). Get a free key at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-ai-hands-on
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# langgraph/observability.py: ENV=dev streams each step, anything else just invokes
ENV=prod
